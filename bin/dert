#!/usr/bin/env bash
# dert — self-documenting control CLI for ~/.dertfiles.
#
# Dispatch is driven by the registries below. A command is reachable (and
# documented) only when it has both a CMD_DESC entry and a matching
# cmd_<group>_<name> function, so help and dispatch cannot drift apart.

set -euo pipefail

VERSION="0.1.0"

# Locate the repo even when invoked through the ~/.local/bin symlink.
self="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || true)"
DERTFILES="${DERTFILES:-$(dirname "$(dirname "$self")")}"
FLAKE_DIR="$DERTFILES/nix"
HOST="$(hostname -s)"

# ── registry ────────────────────────────────────────────────────────────────

GROUP_ORDER=(nix hypr notif idle shot)

declare -A GROUP_DESC=(
  [nix]="NixOS flake, rebuilds, and store management"
  [hypr]="Hyprland session controls"
  [notif]="Desktop notification history"
  [idle]="Keep-awake lock (inhibit idle) shared with the bar's lock icon"
  [shot]="Screen capture via grim/slurp (saves under ~/Pictures/Screenshots)"
)

declare -A CMD_DESC=(
  [nix.build]="Build the system toplevel without switching to it"
  [nix.gc]="Delete old generations and garbage-collect the store"
  [nix.generations]="List NixOS system generations"
  [nix.rebuild]="Rebuild this host's NixOS configuration"
  [nix.rollback]="Switch back to the previous NixOS generation"
  [nix.update]="Update every flake input, or only the named input(s)"
  [hypr.layout]="Set the Hyprland tiling layout"
  [notif.clear]="Delete all persisted notification history"
  [notif.history]="Open the notification history panel"
  [idle.default]="Show or set the keep-awake lock's default duration"
  [idle.off]="Release the keep-awake lock and let idle actions run"
  [idle.on]="Engage the keep-awake lock so the screen stays on"
  [idle.status]="Show the keep-awake lock state and remaining time"
  [idle.toggle]="Toggle the keep-awake lock"
  [shot.region]="Select an area and screenshot it"
  [shot.window]="Screenshot the focused window"
  [shot.output]="Screenshot the focused monitor"
  [shot.full]="Screenshot every monitor"
)

declare -A CMD_USAGE=(
  [nix.update]="[input ...]    e.g. dert nix update pi-nix"
  [hypr.layout]="<dwindle|master|monocle|scrolling>"
  [idle.default]="[duration]    e.g. dert idle default 45m"
  [idle.on]="[duration]    e.g. dert idle on 2h (default: configured, else 1h)"
  [idle.toggle]="[duration]    e.g. dert idle toggle 30m"
  [shot.region]="[options]    screenshot.sh flags pass through, e.g. --edit"
  [shot.window]="[options]"
  [shot.output]="[options]"
  [shot.full]="[options]"
)

# Optional positional-argument completions, keyed like CMD_DESC. Each value is
# the name of a generator function: the completion engine calls it when the
# word being completed follows that command. Commands absent here still get
# group/command completion for free, straight from the registries above.
declare -A CMD_COMPLETE=(
  [nix.update]="flake_inputs"
  [hypr.layout]="hypr_layouts"
  [idle.default]="duration_choices"
  [idle.on]="duration_choices"
  [idle.toggle]="duration_choices"
)

# ── commands ────────────────────────────────────────────────────────────────

cmd_nix_rebuild() {
  cd "$FLAKE_DIR"
  sudo nixos-rebuild switch --flake ".#$HOST" "$@"
}

cmd_nix_build() {
  cd "$FLAKE_DIR"
  nixos-rebuild build --flake ".#$HOST" "$@"
}

cmd_nix_rollback() {
  sudo nixos-rebuild switch --rollback "$@"
}

cmd_nix_update() {
  cd "$FLAKE_DIR"
  nix flake update "$@"
}

cmd_nix_generations() {
  nixos-rebuild list-generations "$@"
}

cmd_nix_gc() {
  sudo nix-collect-garbage -d "$@"
}

cmd_notif_history() {
  qs ipc call notifications showHistory "$@"
}

cmd_notif_clear() {
  qs ipc call notifications clear "$@"
}

cmd_hypr_layout() {
  local mode="${1:-}"
  case "$mode" in
    dwindle|master|monocle|scrolling) ;;
    "")
      err "usage: dert hypr layout <dwindle|master|monocle|scrolling>"
      return 2
      ;;
    *)
      err "unknown layout: $mode (expected dwindle, master, monocle or scrolling)"
      return 2
      ;;
  esac
  hyprctl eval "hl.config({ general = { layout = \"$mode\" } })" >/dev/null
  # The running shell watches this file for the current mode, so dert owns
  # both the switch and the record of it. Path is mirrored in
  # quickshell/widgets/Layout.qml.
  printf '%s\n' "$mode" >"${XDG_RUNTIME_DIR:-/tmp}/hypr-layout"
}

# ── keep-awake lock ─────────────────────────────────────────────────────────
# The bar's lock icon and `dert idle` share nix/hypr/scripts/idle-inhibit.sh.
# The script owns the state file and the configurable default; dert only
# formats the status it prints.

IDLE_SCRIPT="$DERTFILES/nix/hypr/scripts/idle-inhibit.sh"

idle_script() { bash "$IDLE_SCRIPT" "$@"; }

# Seconds as a compact human string ("1h 30m").
format_duration() {
  local total=$1 days hours minutes seconds out=""
  days=$((total / 86400))
  hours=$(((total % 86400) / 3600))
  minutes=$(((total % 3600) / 60))
  seconds=$((total % 60))
  if ((days > 0)); then out+="${days}d "; fi
  if ((hours > 0)); then out+="${hours}h "; fi
  if ((minutes > 0)); then out+="${minutes}m "; fi
  if ((seconds > 0)); then out+="${seconds}s "; fi
  printf '%s\n' "${out% }"
}

# "on" or "off <seconds>" -> a readable lock description.
idle_lock_text() {
  local state="${1%% *}" remaining="${1#* }"
  if [[ $state == off ]]; then
    printf 'engaged — %s remaining' "$(format_duration "$remaining")"
  else
    printf 'released'
  fi
}

cmd_idle_status() {
  local out
  out="$(idle_script status)"
  printf 'Keep-awake lock: %s.\n' "$(idle_lock_text "$out")"
}

cmd_idle_on() {
  local out
  out="$(idle_script inhibit "$@")"
  printf 'Keep-awake lock: %s.\n' "$(idle_lock_text "$out")"
}

cmd_idle_off() {
  idle_script release >/dev/null
  printf 'Keep-awake lock: released.\n'
}

cmd_idle_toggle() {
  local out
  out="$(idle_script toggle "$@")"
  printf 'Keep-awake lock: %s.\n' "$(idle_lock_text "$out")"
}

cmd_idle_default() {
  local seconds
  if (($# > 0)); then
    seconds="$(idle_script default "$1")"
    printf 'Default keep-awake duration set to %s.\n' "$(format_duration "$seconds")"
  else
    seconds="$(idle_script default)"
    printf 'Default keep-awake duration: %s.\n' "$(format_duration "$seconds")"
  fi
}

# ── screenshots ─────────────────────────────────────────────────────────────
# Modes mirror nix/hypr/scripts/screenshot.sh; remaining arguments are passed
# through, so `dert shot region --edit` annotates in satty before saving.

SCREENSHOT_SCRIPT="$DERTFILES/nix/hypr/scripts/screenshot.sh"

shot_script() { bash "$SCREENSHOT_SCRIPT" "$@"; }

cmd_shot_region() { shot_script region "$@"; }
cmd_shot_window() { shot_script window "$@"; }
cmd_shot_output() { shot_script output "$@"; }
cmd_shot_full() { shot_script full "$@"; }

# ── completion ──────────────────────────────────────────────────────────────
# Hidden engine behind the fish `__dert_complete` helper in nix/modules/fish.nix.
# Given the words already typed after `dert`, print the candidates for the next
# word, one per line as `value<TAB>description`; fish turns the tab-separated
# tail into the completion description. Intentionally absent from CMD_DESC: it
# is plumbing, not a user-facing command.

flake_inputs() {
  awk '
    /^  inputs = \{/ { inb = 1; next }
    inb && /^  \};/ { inb = 0; next }
    inb && /^    [A-Za-z0-9_-]+[[:space:]=.]/ {
      sub(/^    /, "")
      sub(/[[:space:]]*[=.].*/, "")
      print
    }
  ' "$FLAKE_DIR/flake.nix" | sort -u
}

hypr_layouts() {
  printf 'dwindle\tRecursive split tiling\n'
  printf 'master\tMaster pane plus stack\n'
  printf 'monocle\tSingle fullscreen window\n'
  printf 'scrolling\tHorizontally scrolling columns\n'
}

# Values offered when completing `dert idle on|toggle|default`.
duration_choices() {
  printf '%s\t%s\n' 15m "15 minutes"
  printf '%s\t%s\n' 30m "30 minutes"
  printf '%s\t%s\n' 1h "1 hour"
  printf '%s\t%s\n' 2h "2 hours"
  printf '%s\t%s\n' 4h "4 hours"
  printf '%s\t%s\n' 8h "8 hours"
}

complete_words() {
  local group="${1:-}" cmd="${2:-}" key

  if [[ -z $group ]]; then
    printf '%s\t%s\n' help "Show all commands and groups"
    printf '%s\t%s\n' version "Print the dert version"
    for group in "${GROUP_ORDER[@]}"; do
      printf '%s\t%s\n' "$group" "${GROUP_DESC[$group]}"
    done
    return 0
  fi

  if [[ -z $cmd ]]; then
    while IFS= read -r key; do
      printf '%s\t%s\n' "${key#*.}" "${CMD_DESC[$key]}"
    done < <(sorted_keys "$group.")
    return 0
  fi

  "${CMD_COMPLETE[$group.$cmd]:-true}"
}

# ── help ────────────────────────────────────────────────────────────────────

err() { printf 'dert: %s\n' "$*" >&2; }

sorted_keys() {
  local prefix="$1" key
  for key in "${!CMD_DESC[@]}"; do
    [[ $key == "$prefix"* ]] && printf '%s\n' "$key"
  done | sort
}

print_groups() {
  local group
  printf 'Usage: dert <group> <command> [args]\n\n'
  printf 'Groups:\n'
  for group in "${GROUP_ORDER[@]}"; do
    printf '  %-10s %s\n' "$group" "${GROUP_DESC[$group]}"
  done
  printf '\nRun `dert <group>` for its commands, or `dert help` for everything.\n'
}

print_group() {
  local group="$1" key
  printf '%s — %s\n\n' "$group" "${GROUP_DESC[$group]}"
  printf 'Usage: dert %s <command> [args]\n\n' "$group"
  printf 'Commands:\n'
  while IFS= read -r key; do
    printf '  %-14s %s\n' "${key#*.}" "${CMD_DESC[$key]}"
  done < <(sorted_keys "$group.")
  printf '\n'
}

print_all() {
  local group
  printf 'dert %s — manage %s\n\n' "$VERSION" "$DERTFILES"
  printf 'Usage: dert <group> <command> [args]\n'
  for group in "${GROUP_ORDER[@]}"; do
    printf '\n%s — %s\n' "$group" "${GROUP_DESC[$group]}"
    while IFS= read -r key; do
      printf '  %-14s %s\n' "${key#*.}" "${CMD_DESC[$key]}"
    done < <(sorted_keys "$group.")
  done
  printf '\n'
}

print_command_help() {
  local group="$1" cmd="$2" key="$group.$cmd"
  printf 'dert %s %s' "$group" "$cmd"
  if [[ -n "${CMD_USAGE[$key]:-}" ]]; then
    printf ' %s' "${CMD_USAGE[$key]}"
  fi
  printf '\n\n%s\n' "${CMD_DESC[$key]}"
}

show_help_for() {
  local group="${1:-}" cmd="${2:-}"
  if [[ -z $group ]]; then
    print_all
    return 0
  fi
  if [[ -z "${GROUP_DESC[$group]:-}" ]]; then
    err "unknown group: $group"
    printf '\n'
    print_groups >&2
    return 2
  fi
  if [[ -z $cmd ]]; then
    print_group "$group"
    return 0
  fi
  if [[ -z "${CMD_DESC[$group.$cmd]:-}" ]]; then
    err "unknown command: $group $cmd"
    printf '\n'
    print_group "$group" >&2
    return 2
  fi
  print_command_help "$group" "$cmd"
}

# ── dispatch ────────────────────────────────────────────────────────────────

main() {
  local group="${1:-}"
  case "$group" in
    ""|-h|--help)
      print_groups
      return 0
      ;;
    help)
      shift
      show_help_for "${1:-}" "${2:-}"
      return 0
      ;;
    version|--version)
      printf 'dert %s\n' "$VERSION"
      return 0
      ;;
    __complete)
      shift
      complete_words "$@"
      return 0
      ;;
  esac

  if [[ -z "${GROUP_DESC[$group]:-}" ]]; then
    err "unknown group: $group"
    printf '\n'
    print_groups >&2
    return 2
  fi

  if (( $# == 1 )) || [[ "${2:-}" == "-h" || "${2:-}" == "--help" ]]; then
    print_group "$group"
    return 0
  fi

  local cmd="$2" key="$group.$2"
  if [[ -z "${CMD_DESC[$key]:-}" ]]; then
    err "unknown command: $group $cmd"
    printf '\n'
    print_group "$group" >&2
    return 2
  fi

  if [[ "${3:-}" == "-h" || "${3:-}" == "--help" ]]; then
    print_command_help "$group" "$cmd"
    return 0
  fi

  local fn="cmd_${group}_${cmd//-/_}"
  if ! declare -F "$fn" >/dev/null; then
    err "internal: no handler $fn for $key"
    return 70
  fi

  shift 2
  "$fn" "$@"
}

main "$@"
